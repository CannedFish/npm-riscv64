# Metadata for rolldown 1.3.3 (see docs/recipe-spec.md).
#
# rolldown ships one npm package that carries both a JavaScript wrapper and a
# per-platform native binding. Upstream publishes no riscv64 binding: napi.targets
# has no riscv64 entry, the 16 optionalDependencies name no riscv64 package, and
# @rolldown/binding-linux-riscv64-gnu exists on npm only as an empty 0.0.0
# placeholder. The wrapper itself is ready for it, though - its loader already
# probes for a binding inside the package before falling back to the separate
# binding package:
#
#   require('./rolldown-binding.linux-riscv64-gnu.node')   // dist/shared/
#   require('@rolldown/binding-linux-riscv64-gnu')          // fallback
#
# so one package that carries our own binding under dist/shared/ works unchanged,
# and no source patch is needed anywhere.
#
# The published name stays "rolldown" on purpose: the package is the wrapper the
# ecosystem depends on, and a consumer that resolves it from a registry carrying
# this recipe gets riscv64 support from a plain `npm i rolldown`. Publishing it as
# @ruyirepo/rolldown would hide it behind a rename and leave `npm i rolldown`
# resolving to the binding-less upstream package.
upstream:
  repo: https://github.com/rolldown/rolldown
  ref: v1.3.3

# A large Rust workspace. Cross-compiling it on amd64 takes minutes; the same build
# inside the riscv64 container under qemu did not finish a single crate in ten
# minutes, so the build runs on the host architecture and only the test steps run
# on riscv64 (see .dsh/plan.md D26).
toolchain: cross

artifacts:
  path: out/rolldown/dist/shared/*.node

npm_publish:
  - role: main
    name: rolldown
    version: 1.3.3
    dir: out/rolldown
    # Trailing slash matters: npm derives its credential key from the URL as a
    # directory (new URL('.', url)), so without it npm looks one segment up
    # (//host/repository/) and the auth line below never matches.
    registry: https://forgestash-old.verify.oepkgs.net/repository/npm-rv-test-local/
    token_env: NODE_AUTH_TOKEN
    # Basic credentials: base64 of "user:password" (see bufferutil for why).
    auth: basic
    # The wrapper manifest comes from the pinned upstream tarball; the renderer
    # rewrites name/version/publishConfig so the published package is ours.
    generate_manifest: true

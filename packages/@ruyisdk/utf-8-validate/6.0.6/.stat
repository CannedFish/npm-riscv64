# Metadata for @ruyisdk/utf-8-validate 6.0.6 (see docs/recipe-spec.md).
#
# Same shape as bufferutil: upstream ships one package that carries per-platform
# prebuilds (prebuilds/<platform>-<arch>/utf-8-validate.node, loaded by
# node-gyp-build), so a single publish target is enough and the addon is built
# from source and staged as a prebuild.
#
# The addon is N-API (src/validation.cc ends with NAPI_MODULE), so one build serves
# every supported Node version - no per-ABI prebuild variants are needed.

upstream:
  repo: https://github.com/websockets/utf-8-validate
  ref: v6.0.6

artifacts:
  path: prebuilds/linux-riscv64/*.node

npm_publish:
  - role: main
    name: "@ruyisdk/utf-8-validate"
    version: 6.0.6
    dir: .
    registry: https://npm.pkg.github.com
    token_env: NODE_AUTH_TOKEN
    # The upstream manifest says "utf-8-validate"; republishing under our scope is
    # a deliberate re-brand, so the renderer writes name/version from here.
    generate_manifest: true
